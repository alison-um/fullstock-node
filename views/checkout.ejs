
<section class="checkout">

    <div class="checkout__content section-sm container">

        <section class="checkout__products">
                        
            <h2 class="checkout__subtitle-orden">
                Resumen de la orden
            </h2>
            <div class="checkout__list">
                <!-- componente summary-item -->
                <% cartItems.forEach((item) => { %>
                <article class="summary-item border-bottom">
                    <div class="summary-item__media">
                        <img src="<%=item.product.imagePath%>" alt="" class="summary-item__image">
                    </div>
                    <div class="summary-item__detalles">
                        <div class="summary-item__header">
                            <p class="summary-item__producto"><%=item.product.name%></p>
    
                        </div>
                        <div class="summary-item__content">
                            <!-- <p class="cart-item__precio">SubTotal: S/ <%= (item.subtotal /100).toFixed(2) %></p> -->
                            <p class="summary-item__label"><%=item.quantity%></p>
                            
                            <img src="/icons/x.svg" alt="Indicador para cantidad por producto"
                                class="summary-item__btnicon">
                            
                            <p class="summary-item__label">S/ <%=(item.product.price / 100).toFixed(2)%></p>
                        </div>
                    </div>
                </article>
                <% }) %>
                
    
                <div class="checkout__total">
                    <span>Total</span>
                    <span>S/ <%= (total / 100).toFixed(2) %></span>
                </div>
                
            </div>
        </section>
    
        <!-- componente: checkout-form -->
        <section class="checkout-form">
    
            <form action="/checkout/place-order" method="post" class="checkout-form__group">
    
                <fieldset class="checkout-form__contacto border-bottom">
                    <legend class="checkout-form__subtitle">Información de contacto</legend>
                    
                    <!-- componente:  form-field -->
                    <div class="form-field">
                        <label for="email" class="label">Correo electrónico</label>
                        <input 
                            type="email"
                            id="email" 
                            name="email" 
                            autocomplete="email"
                            required
                            class="input input--checkout"
                        >
                    </div>
                </fieldset>
    
                <fieldset class="checkout-form__envio">
                    <legend class="checkout-form__subtitle">Información de envío</legend>
    
                    <div class="checkout-form__envio-grupo">
    
                        <div class="checkout-form__row">  <!--Nombre y Ape-->
                            <div class="form-field">
                                <label for="firstName" class="label">Nombre</label>
                                <input 
                                    type="text" 
                                    id="firstName" 
                                    name="firstName" 
                                    autocomplete="given-name"
                                    required
                                    class="input input--checkout"
                                >
                            </div>
                            <div class="form-field">
                                <label for="lastName" class="label">Apellido</label>
                                <input 
                                    type="text" 
                                    id="lastName" 
                                    name="lastName" 
                                    autocomplete="family-name"
                                    required
                                    class="input input--checkout"
                                >
                            </div>
                        </div>
    
                        <div class="form-field">
                            <label for="company" class="label">Compañía</label>
                            <input 
                                type="text" 
                                id="company" 
                                name="company" 
                                autocomplete="organization" 
                                class="input input--checkout"
                            >
                        </div>
    
                        <div class="form-field">
                            <label for="address" class="label">Dirección</label>
                            <input 
                                type="text" 
                                id="address" 
                                name="address" 
                                autocomplete="street-address"
                                class="input input--checkout"
                            >
                        </div>
    
                        <div class="checkout-form__row">  <!--Ciudad Pais-->
    
                            <div class="form-field">
                                <label for="city" class="label">Ciudad</label>
                                <input 
                                    type="text" 
                                    id="city"
                                    name="city"
                                    autocomplete="address-level2"
                                    required 
                                    class="input input--checkout"
                                >
                            </div>
                            <div class="form-field">
                                <label for="country" class="label">País</label>
                                <!-- componente: select -->
                                <select 
                                    id="country"
                                    name="country"
                                    autocomplete="country" 
                                    required
                                    class="select select--checkout"
                                >
                                    <option value="">Seleccionar país</option>
                                    <option value="AR">Argentina</option>
                                    <option value="BO">Bolivia</option>
                                    <option value="CL">Chile</option>
                                    <option value="CO">Colombia</option>
                                    <option value="CR">Costa Rica</option>
                                    <option value="CU">Cuba</option>
                                    <option value="DO">República Dominicana</option>
                                    <option value="EC">Ecuador</option>
                                    <option value="SV">El Salvador</option>
                                    <option value="GT">Guatemala</option>
                                    <option value="HN">Honduras</option>
                                    <option value="MX">México</option>
                                    <option value="NI">Nicaragua</option>
                                    <option value="PA">Panamá</option>
                                    <option value="PY">Paraguay</option>
                                    <option value="PE">Perú</option>
                                    <option value="PR">Puerto Rico</option>
                                    <option value="UY">Uruguay</option>
                                    <option value="VE">Venezuela</option>
                                </select>
                            </div>
                        </div>  
    
                        <div class="checkout-form__row">  <!--Prov CodigoP-->
    
                            <div class="form-field">
                                <label for="region" class="label">Provincia/Estado</label>
                                <input 
                                    type="text" 
                                    id="region" 
                                    name="region" 
                                    autocomplete="address-level1"
                                    required 
                                    class="input input--checkout"
                                >
                            </div>
                            <div class="form-field">
                                <label for="zipCode" class="label">Código postal</label>
                                <input 
                                    type="text" 
                                    id="zipCode" 
                                    name="zipCode" 
                                    autocomplete="postal-code"
                                    required
                                    class="input input--checkout"
                                >
                            </div>
    
                        </div> 
                        
                        <div class="form-field">
                            <label for="phone" class="label">Teléfono</label>
                            <input 
                                type="text" 
                                id="phone" 
                                name="phone" 
                                autocomplete="tel" 
                                required
                                class="input input--checkout"
                            >
                        </div>
                    </div>
    
                </fieldset>
    
                <div class="checkout-form__button">
                    <button type="submit" class="button button--primary button--xl button--carrito">
                        Confirmar Orden
                    </button>
                </div>
    
            </form>
    
            
    
        </section>

    </div>

</section>