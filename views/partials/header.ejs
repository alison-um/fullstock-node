<header class="header">

    <div class="header__topbar">
        <div class="header__auth-links container">
            
            <a href="/log-in" class="header__auth-link">Iniciar sesión</a>
            <a href="/sign-up" class="header__auth-link">Crear una cuenta</a>
            
        </div>
    </div>

    
    <div class="main-header container">
            
        <a class="main-header__logo" href="/">
            <img src="/logos/logo_fullstack.svg" alt="FullStack inicio">
        </a>

        <div class="main-header__actions">

            
            <a href="#" class="button button--ghost button--xl-icon ">
                <img src="/icons/search.svg" alt="Lupa">
            </a>
            <a href="/log-in" class="button button--ghost button--xl-icon">
                <img src="/icons/user-2.svg" alt="User">
            </a>

            <a 
                href="/cart" 
                class="button button--ghost button--xl-icon main-header__icon--cart" 
                aria-label="Carrito de compras"
            >
                <img src="/icons/shopping-cart.svg" alt="Carrito de compra">
                <span class="main-header__cart-badge">
                    <%= countCartProducts %>
                </span>
            </a>
            
        </div>
        

        <div class="main-header__separator"></div>

        <nav class="main-nav" aria-label="Navegación principal" >
            
            <ul class="main-nav__list" role="menubar">
                <li role="none">
                    <a href="/categories/polos" role="menuitem" class="nav-item">Polos</a>
                </li>
                <li role="none">
                    <a href="/categories/tazas" role="menuitem" class="nav-item">Tazas</a>
                </li>
                <li role="none">
                    <a href="/categories/stickers" role="menuitem" class="nav-item">Stickers</a>
                </li>
            </ul>
        </nav>

    </div>
    
</header>


