<%- include('partials/header'); %>
        <main class="auth container section-sm">

            <section class="auth__content">

                <h1 class="auth__title">
                    Inicia sesión en tu cuenta
                </h1>

                <form action="" method="post" class="auth__form">
            
                    <!-- componente:  form-field -->
                    <div class="form-field">
                        <label for="login-email" class="label">Correo electrónico</label>
                        <input type="email" id="login-email" name="login-email" placeholder="testino@gmail.com" class="input input--auth" required>
                    </div>
                    <div class="form-field">
                        <label for="login-pass" class="label">Contraseña</label>
                        <input type="password" id="login-pass" name="login-contraseña" class="input input--auth" required>
                    </div>

                    <div>
                        <button type="submit" class="button button--primary button--lg button--auth">
                            Iniciar sesión
                        </button>
                    </div>

                </form>

                <div class="auth__footer">
                    <p class="auth__label">
                        ¿Aún no tienes cuenta?
                    </p>
                    <a href="/sign-up" class="auth__option">
                        Crea una cuenta
                    </a>
                </div>
            </section>

        </main>
<%- include('partials/footer'); %>