
<section class="products">
  <div class="container border-bottom">
    <div class="products__info section-sm">
      <h1 class="products__category"><%=category.name%></h1>
      <p class="products__description"><%=category.description%></p>
    </div>
  </div>

  <div class="container">
    <div class="products__content section-sm">
      
      <form action="/categories/<%=category.slug%>" method="get">
        <fieldset class="price-filter">
          <legend class="price-filter__title">Precio</legend>
            
          <div class="price-filter__labels">
            <div class="price-filter__field">
              <label for="minPrice" class="price-filter__label">Min</label>
              <input 
                type="number" 
                id="minPrice" 
                name="minPrice" 
                value="<%=minPrice%>"
                min="0" 
                step="0.01" 
                class="input input--price"
              >
            </div>

            <div class="price-filter__field">
              <label for="maxPrice" class="price-filter__label">Max</label>
              <input 
                type="number" 
                id="maxPrice" 
                name="maxPrice" 
                value="<%=maxPrice%>"
                min="0" 
                step="0.01" 
                class="input input--price"
              >
            </div>
          </div>
            
          <button type="submit" id="btn-calcular" class="button button--secondary button--xl">
            Filtrar productos
          </button>
        </fieldset>
      </form>
      <% if(products.length == 0) { %>
        <div class="products__no-stock">
          <h3 class="products__no-stock-title">No hay productos para esta categoría.</h3>
          <p class="products__no-stock-description">Intenta cambiar de categoría o los filtros aplicados.</p>
          <img src="/icons/no-stock.svg" alt="">
        </div>
      <% }else { %>
      <div class="products-grid">
        <% products.forEach((product) => { %>
          <a href="/products/<%=product.id%>" class="product">
            <div class="product__media">
              <span class="product__badge">🚀 Oferta</span>
              <img 
                src="<%=product.imagePath%>" 
                alt="<%=product.imageDescription%>" 
                class="product__image"
              />
            </div>
              
            <div class="product__info">
              <h3 class="product__title"><%=product.name%></h3>
              <p class="product__description"><%=product.description%></p>
              <span class="product__price">S/ <%=(product.price/100)%></span>
            </div>
          </a>   
        <% }) %>       
      </div>
      <% } %>

    </div>
  </div>

</section>
      
    